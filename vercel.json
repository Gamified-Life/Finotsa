{
  "rewrites": [
    {
      "source": "/api/extract",
      "destination": "/api/extract"
    },
    {
      "source": "/api/((?!extract).*)",
      "destination": "/api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/health-score",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/engine-sweep",
      "schedule": "15 0 * * *"
    }
  ]
}
